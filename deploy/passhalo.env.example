# Copy to /etc/passhalo/passhalo.properties on the VPS; never commit the real values.
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=passhalo
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRATION_TIME=86400000
PII_ENCRYPTION_KEY=replace-with-a-random-base64-key
PII_LOOKUP_KEY=replace-with-a-different-random-base64-key
FRONTEND_BASE_URL=https://passhalo.it
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM=replace-with-verified-sender-address
HIBERNATE_DDL_AUTO=validate
